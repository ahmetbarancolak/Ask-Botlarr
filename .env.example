# ===== Guard Bot .env Örnek Dosyası =====
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin

# --- Discord Bot Token'ları ---
# Discord Developer Portal'dan alın: https://discord.com/developers/applications
BOT1_TOKEN=Guard_1_Tokenini_Buraya_Yaz
BOT2_TOKEN=Guard_2_Tokenini_Buraya_Yaz

# --- MongoDB Bağlantısı ---
# MongoDB Atlas'tan alın: https://cloud.mongodb.com
# Format: mongodb+srv://<kullanıcı>:<şifre>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://kullanici_adi:sifre@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=guardbot

# --- Supabase (Opsiyonel - yedek veri katmanı) ---
VITE_SUPABASE_URL=https://proje-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
